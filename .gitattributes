# Default: treat all files as text, normalise line endings to LF on
# checkin, and check out with LF on every platform. This avoids CRLF
# noise on Windows clones and keeps golden vectors byte-stable.
* text=auto eol=lf

# Shell scripts and Rust sources are always LF, regardless of the
# auto-detection above.
*.sh   text eol=lf
*.bash text eol=lf
*.zsh  text eol=lf
*.fish text eol=lf
*.rs   text eol=lf

# Cargo.lock is dense, machine-generated, and noisy in diffs. Treat it
# as binary so `git diff` skips the body by default; tools that need
# the full diff can pass `--text` explicitly.
Cargo.lock -diff
rust/tests/golden/redaction/*.bin -diff -text
rust/tests/golden/transport/*.bin -diff -text

# Collapse committed generated bindings and vendored sources in GitHub review.
rust/crates/*/generated/** linguist-generated=true
apps/repo-worker/generated/** linguist-generated=true
apps/web/vendor/mkit-repo-proto/generated/** linguist-generated=true
contrib/signers/mkit-sign-se/Sources/mkit-sign-se/Generated/** linguist-generated=true
rust/vendor/** linguist-vendored=true

# Hide binary golden payload diffs without changing their text/eol attributes.
rust/tests/golden/**/*.bin -diff
# These wire/object vectors are emitted by the golden generators.
rust/tests/golden/objects/**/*.json linguist-generated=true
rust/tests/golden/grants/**/*.json linguist-generated=true
rust/tests/golden/http-objects/*.json linguist-generated=true
rust/tests/golden/url-token/tokens.json linguist-generated=true
rust/tests/golden/proofs/**/*.json linguist-generated=true
rust/tests/golden/disclosure/**/*.json linguist-generated=true
rust/tests/golden/closure/**/*.json linguist-generated=true
rust/tests/golden/uploads/**/*.json linguist-generated=true
rust/tests/golden/refs-index/**/*.json linguist-generated=true

# Files excluded from `git archive` tarballs. Release tarballs ship
# only the buildable source tree; CI config, test fixtures, fuzz
# harnesses, the web demo site, contributor scripts, and release-only
# documentation are dropped.
.github/         export-ignore
.gitattributes   export-ignore
.gitignore       export-ignore
.editorconfig    export-ignore
rust/fuzz/       export-ignore
rust/tests/      export-ignore
tests/           export-ignore
web/             export-ignore
scripts/         export-ignore
contrib/         export-ignore
