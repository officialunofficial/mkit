{
  "name": "mkit-demo-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:build": "rm -rf vendor/mkit-wasm/pkg && cd ../rust/crates/mkit-wasm && wasm-pack build --target web --out-dir ../../../web/vendor/mkit-wasm/pkg --release",
    "dev": "waku dev",
    "build": "pnpm wasm:build && CLOUDFLARE=1 waku build && node scripts/patch-worker-config.mjs && node scripts/fix-preload-as.mjs",
    "start": "waku start",
    "deploy": "pnpm build && wrangler deploy -c dist/server/wrangler.json",
    "preview": "pnpm build && wrangler dev -c dist/server/wrangler.json",
    "test": "pnpm wasm:build && vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "typecheck": "pnpm wasm:build && tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.25",
    "mkit-wasm": "link:vendor/mkit-wasm",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-server-dom-webpack": "~19.2.7",
    "waku": "1.0.0-alpha.8"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.99.0"
  }
}
