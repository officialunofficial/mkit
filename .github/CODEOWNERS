# CODEOWNERS — see https://docs.github.com/articles/about-codeowners
# Review routing for the officialunofficial GitHub org.
#
# Owners route to @officialunofficial/officialunofficial, an existing
# provisioned team, so required-review routing resolves to real reviewers.
# If/when dedicated teams (@officialunofficial/mkit-maintainers,
# @officialunofficial/mkit-crypto) are provisioned with members, swap the
# assignments below for those teams.

*                                @officialunofficial/officialunofficial

# Security-sensitive surfaces require crypto-aware review
/rust/crates/mkit-attest/        @officialunofficial/officialunofficial
/rust/crates/mkit-keystore/      @officialunofficial/officialunofficial
/rust/crates/mkit-rpc/           @officialunofficial/officialunofficial

# CI + release tooling
/.github/                        @officialunofficial/officialunofficial
/install.sh                      @officialunofficial/officialunofficial
/scripts/                        @officialunofficial/officialunofficial

# On-disk + wire formats — changes need spec sign-off
/docs/specs/SPEC-*.md                  @officialunofficial/officialunofficial
/rust/tests/golden/              @officialunofficial/officialunofficial
