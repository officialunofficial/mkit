// Cloudflare Worker config for keys.mkit.sh — the SQLite-backed pubkey→handle
// registry. JSONC to match the org convention (apps/repo-worker). Build with
// worker-build, which compiles the cdylib to wasm32 and emits the ES-module
// shim into ./build.
{
  "name": "mkit-keys",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2024-09-23",
  "vars": { "AUTH_AUDIENCE": "https://keys.mkit.sh" },
  "durable_objects": { "bindings": [{ "name": "NAME_STORE", "class_name": "NameStore" }] },
  "migrations": [{ "tag": "auth-v2-names", "new_sqlite_classes": ["NameStore"] }],
  // The CF Workers Build image has NO Rust toolchain — install rustup (pinned
  // 1.95.0 + wasm32) and worker-build, then compile. Guarded by `command -v` so
  // it's a no-op where they already exist (local `wrangler deploy`).
  "build": {
    "command": "(command -v cargo >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.95.0 -t wasm32-unknown-unknown) && . \"$HOME/.cargo/env\" && (command -v worker-build >/dev/null 2>&1 || cargo install -q worker-build) && worker-build --release"
  },

  "observability": { "enabled": true },

  // Accepted/rejected-write telemetry for `PUT /name/<pubkey>` (`log_write`
  // in src/lib.rs) — {procedure, signer_pubkey, bytes} on accept,
  // {procedure, reason, status} on reject. Binding name mirrors
  // apps/repo-worker/wrangler.jsonc so the two datasets share vocabulary.
  // See #695.
  "analytics_engine_datasets": [
    { "binding": "WRITE_EVENTS", "dataset": "mkit_keys_write_events" }
  ],

  // Production origin. keys.mkit.sh gives the web app a deterministic host for
  // its CSP `connect-src` and `VITE_KEYS_URL`. `custom_domain` auto-provisions
  // DNS + cert on the mkit.sh zone.
  "routes": [{ "pattern": "keys.mkit.sh", "custom_domain": true }],

  // Staging has its own Durable Object namespace, route and audience.
  "env": {
    "staging": {
      "name": "mkit-keys-staging",
      "vars": { "AUTH_AUDIENCE": "https://staging-keys.mkit.sh" },
      "durable_objects": { "bindings": [{ "name": "NAME_STORE", "class_name": "NameStore" }] },

      // Non-production route so auth/rate-limit changes can be validated
      // against a real Cloudflare deployment before promotion to
      // keys.mkit.sh. Update apps/web/src/security-policy.js CSP
      // `connect-src` (and the web build's `VITE_KEYS_URL`) if the web app
      // needs to target this host for end-to-end checks.
      "routes": [{ "pattern": "staging-keys.mkit.sh", "custom_domain": true }],

      // Dedicated staging dataset — `analytics_engine_datasets` is also a
      // non-inheritable key (see link above), so without this the staging
      // deployment's write-path logging would silently drop instead of
      // mirroring it. Analytics Engine datasets need no explicit
      // pre-creation: the first write_data_point call creates
      // them.
      "analytics_engine_datasets": [
        { "binding": "WRITE_EVENTS", "dataset": "mkit_keys_write_events_staging" }
      ]
    }
  }
}
