// Local-dev config: no-op build (wasm prebuilt) to avoid the worker-build
// rebuild loop. NameStore uses local SQLite Durable Objects.
//   wrangler dev -c wrangler.dev.jsonc --local
{
  "name": "mkit-keys",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2024-09-23",
  "vars": { "AUTH_AUDIENCE": "http://localhost:8789" },
  "durable_objects": { "bindings": [{ "name": "NAME_STORE", "class_name": "NameStore" }] },
  "migrations": [{ "tag": "auth-v2-names", "new_sqlite_classes": ["NameStore"] }],
  "build": { "command": "true" }
}
