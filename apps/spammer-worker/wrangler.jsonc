// Cloudflare Worker config for `mkit-spammer` — a synthetic-activity generator
// that drives real, validly-signed writes into a live mkit-repo-worker room.
// JSONC to match the org's Worker config convention (apps/repo-worker,
// apps/mcp). Plain TS worker (no worker-build/Rust cross-compile) — the two
// vendored wasm crates (`mkit-wasm`, `mkit-repo-client`) are built ahead of
// deploy by the `wasm:build` package script, exactly like `apps/web`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mkit-spammer",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  "observability": { "enabled": true },

  // DORMANT BY DEFAULT — but NOT because the `Spammer` DO reads this var: it
  // doesn't (grep confirms `env.ENABLED` is never read in `src/`). The real
  // gate is the DO's own `enabled` flag in its Durable Object storage, which
  // starts false on first construction and is flipped only by the
  // authenticated `/control` endpoint at runtime (see README). This var is a
  // human-readable reminder of that intent only — setting it to "true" here
  // does NOT arm the worker, and setting it to "false" is not itself a kill
  // switch. The real kill switch is `POST /control?action=disable`.
  //
  // ROOM/REPO_BASE_URL point at the target mkit-repo-worker room.
  //
  // GO-LIVE (this diff): ROOM is now "lobby-v2", the real default room real
  // visitors land on at mkit.sh — verified first against the throwaway
  // "spammer-test" room per README's staged-rollout procedure (real signed
  // commits/chat/remixes observed landing and fully stopping on disable
  // against the deployed Worker, not just local wrangler dev). Still
  // ENABLED="false" / DO-storage-disabled by default — deploying this diff
  // does not itself start anything; a separate authenticated
  // `/control?action=enable` call is still required. Kill switch
  // (`/control?action=disable`) stays available at all times — see README.
  "vars": {
    "ENABLED": "false",
    "ROOM": "lobby-v2",
    "REPO_BASE_URL": "https://api.mkit.sh"
  },

  // CONTROL_TOKEN (a Worker *secret*, set via `wrangler secret put
  // CONTROL_TOKEN` — deliberately NOT declared here; secrets never belong in
  // wrangler.jsonc) gates the `/control` enable/disable/status endpoint. An
  // unset secret must fail every `/control` call closed, never open.

  // Responder (#848/#854) — an independent opt-in layer on top of the
  // ambient loop above, gated by its OWN "responderEnabled" DO-storage flag
  // (`/control?action=responder-enable`/`responder-disable`), disabled by
  // default. Two more optional vars govern it, same "deliberately not set
  // here" posture as AI_CONTENT_AUTO_REFRESH below:
  //   - AI_REPLY_PERSONALIZATION="true" opts into a small, hard-budgeted
  //     (see reply-budget.ts) per-event AI-personalized reply on top of the
  //     zero-marginal-cost reply-template fallback that's always active.
  //   - RESPONDER_NONHUMAN_ALLOWLIST is a comma-separated list of additional
  //     known-non-human pubkeys (e.g. legacy seeded demo authors, if any)
  //     the responder should never treat as a real user to respond to —
  //     empty/unset by default (see responder.ts's mergedSyntheticPubkeys).

  // No account_id here — deploys to the same Official Unofficial, Inc.
  // account other apps/* Workers use, resolved via the CLOUDFLARE_ACCOUNT_ID
  // env var at deploy time like apps/repo-worker, apps/keys-worker, apps/mcp
  // (see apps/og/wrangler.toml). No `routes`/`custom_domain` here: this
  // Worker is workers.dev-only and must never intercept mkit.sh /
  // api.mkit.sh traffic — it is purely an outbound client.

  // The `Spammer` Durable Object: one singleton instance owns the
  // self-rescheduling alarm loop + per-identity rate-floor bookkeeping in its
  // own SQLite storage.
  "durable_objects": {
    "bindings": [{ "name": "SPAMMER", "class_name": "Spammer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Spammer"] }],

  // Workers AI, for an OPT-IN periodic (every ~20 min, see ai-content.ts's
  // CONTENT_REFRESH_EVERY_N_TICKS) background refresh of the chat/commit/
  // remix phrase pools — never called synchronously on the hot 1s alarm
  // tick. Automatic refresh requires AI_CONTENT_AUTO_REFRESH="true"
  // (deliberately NOT set here, so it defaults off) — a live run against
  // lobby-v2 showed the model can drift into inventing a fictional feature
  // narrative for what are actually empty-tree (no real file changes)
  // commits, which reads as misleading rather than as a real mkit demo. The
  // prompt is now tightened against that, but auto-refresh stays opt-in
  // until proven; a manual `/control?action=refresh-content` is always
  // available, and `/control?action=reset-content` immediately reverts to
  // content.ts's curated static pool. Any AI failure (quota, timeout,
  // malformed output) already falls back to that same static pool — see
  // ai-content.ts's doc comment.
  "ai": { "binding": "AI" }
}
