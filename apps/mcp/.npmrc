# `agents` declares a zod@^4 peer for its AI-chat features (unused here); the
# MCP SDK itself targets zod 3. pnpm tolerates this; npm needs it spelled out.
# Matches the same resolution used elsewhere in the org for this agents/zod arrangement.
#
# Because peers are not auto-installed here, any *required* (non-optional)
# peer that `agents` resolves at runtime has to be listed explicitly in
# package.json — that is why @modelcontextprotocol/client and
# @modelcontextprotocol/server are direct dependencies: agents/mcp imports
# both, and without them the integration tests fail to load the worker.
legacy-peer-deps=true
