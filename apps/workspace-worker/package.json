{
  "name": "mkit-workspace-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "wasm:build": "cd ../../rust/crates/mkit-wasm && wasm-pack build --target web --out-dir ../../../apps/workspace-worker/vendor/mkit-wasm --release"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.151.0"
  }
}
