// Inert binding template; copy into your Worker environment after provisioning.
// PRESERVATION must use a bucket distinct from STORAGE, with no public access,
// CDN/custom domain, lifecycle deletion, or serving/GC/dedup credentials.
// Only this admin/preservation Worker receives the restricted bucket binding.
// Do not deploy this template directly. No bucket is created by mkit.
{
  "r2_buckets": [{ "binding": "PRESERVATION", "bucket_name": "REPLACE_PRIVATE_PRESERVATION_BUCKET" }],
  "vars": {
    // Activation requires the validated Paid Uno launch profile and complete
    // preservation, admin and signed cache-purge configuration.
    "TAKEDOWN_ENABLED": "true",
    "PRESERVATION_RETENTION_MS": "REPLACE_EXPLICIT_POSITIVE_DURATION",
    "RECEIPT_KEYS": "REPLACE_VERSION_1_PUBLIC_KEY_LIST"
  }
  // Configure RECEIPT_NOTICE_KEY and ADMIN_KEYS as secrets. The receipt key
  // must be distinct from admin, hook, URL-token, write and upload-MAC keys.
  // Enable only with indexed opt-in, Workers Paid and a configured namespace policy (Any discovery stays incomplete).
}
