// Cloudflare Worker config for the mkit reference `mkit.transport.v1` server.
// JSONC to match the org's Worker config convention + apps/repo-worker's
// precedent. Build with worker-build (the workers-rs cross-platform build
// command), which compiles the cdylib to wasm32 and emits the ES-module shim
// into ./build.
{
  "name": "mkit-vcs-worker",
  "main": "build/worker/shim.mjs",
  // The date the pinned wrangler's workerd supports (as
  // apps/workspace-worker); scripts/vcs-worker-conformance.sh passes on it.
  "compatibility_date": "2026-09-09",
  // Same rationale as apps/repo-worker/wrangler.jsonc: the Cloudflare
  // Workers Build image ships no Rust toolchain, so this installs rustup
  // (pinned 1.95.0 + wasm32) and worker-build, guarded by `command -v` so
  // it's a no-op wherever they already exist (local `wrangler deploy`).
  "build": {
    "command": "(command -v cargo >/dev/null 2>&1 || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.95.0 -t wasm32-unknown-unknown) && . \"$HOME/.cargo/env\" && (command -v worker-build >/dev/null 2>&1 || cargo install -q worker-build) && worker-build --release"
  },

  "observability": { "enabled": true },
  // Install the deployment upload MAC keys with `wrangler secret put TICKET_KEYS` (WP-1.19).
  // Override AUTH_AUDIENCE with the exact published origin before deployment.
  // WORKERS_PLAN caps each Durable Object's SQLite store for the account's
  // plan: `free` (1 GB, the safe default) or `paid` (10 GB). Set `paid` only
  // once the account is confirmed on Workers Paid: a Paid cap on a Free
  // account runs into the 1 GB hard limit, which resets the object.
  "vars": {
    "AUTH_AUDIENCE": "http://localhost:8787",
    // AUTH_REPOSITORY names the single repository under ADDRESSING=single
    // (the default). Under ADDRESSING=multi it is ignored: every request's
    // X-Repository <ns>/<name> selects its repository.
    "AUTH_REPOSITORY": "default",
    "WORKERS_PLAN": "free",
    // The root RefStore sharding marker refuses changes over existing data (R-94).
    "SHARDING": "single"
    // ADDRESSING=multi serves every namespace its policy admits and
    // requires TICKET_KEYS. Like SHARDING, ADDRESSING installs a root marker
    // (`am 00`) on the first request; changing it over existing data is
    // refused. NAMESPACE_POLICY=allowlist (the multi default)
    // then requires NAMESPACE_ALLOWLIST: namespaces one per line or
    // comma-separated, `#` comments allowed. NAMESPACE_POLICY=any admits
    // every namespace and requires UNSAFE_OPEN_NAMESPACES=true (D27;
    // development only).
    // HOOK_ROLES=admit,outcome (with the ADMISSION_HOOK binding below),
    // HOOK_TIMEOUT_MS and AUTHORIZER_ROLE: see README.md "Remote hooks".
    // Optional NAMESPACE_LOCATION_HINT / NAMESPACE_JURISDICTION are deployment-wide.
    // Jurisdiction (eu, us, fedramp) is fixed for the deployment lifetime:
    // changing it re-maps all names to new, empty objects.
  },

  // Remote hooks (WP-3.9): to run authorization, admission or outcome delivery
  // in another Worker, bind it here and set HOOK_ROLES in `vars` (a comma list
  // of authorize, admit and outcome; no default). The hook Worker must have no
  // public route (workers_dev and preview_urls off): an unsigned service
  // binding is only safe if nothing else can reach it (SPEC-SERVER §7.3).
  // "services": [
  //   { "binding": "ADMISSION_HOOK", "service": "my-admission-hook" }
  // ],

  // Smart Placement: run the Worker close to its back-end (the RefStore DO +
  // R2), not just at the edge nearest the client.
  "placement": { "mode": "smart" },

  // NOTE: no `routes`/`custom_domain` yet — this reference server has not
  // been deployed. Add a route (and update any client's default endpoint)
  // when a production deployment is provisioned; see README.md "Deploy".

  // R2 object store for content-addressed packs. Key layout:
  // packs/{hex(pack_id)}.
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "mkit-vcs-objects" },
    // Create this bucket and its backups/-only lifecycle rule before deploy.
    { "binding": "BACKUPS", "bucket_name": "mkit-vcs-backups" }
  ],

  // Single deployments use RefStore (instance "root"). D34 routes each
  // partition kind to its class; repo and ref-name indexes share a binding.
  "durable_objects": { "bindings": [
    { "name": "REFSTORE", "class_name": "RefStore" },
    { "name": "NS_COORD", "class_name": "NsCoordinator" },
    { "name": "REF_SHARD", "class_name": "RefShard" },
    { "name": "REPO_INDEX", "class_name": "RepoIndexShard" },
    { "name": "CONTENT_INDEX", "class_name": "ContentIndexShard" }
  ] },

  // Keep `migrations`: wrangler's newer `exports`-style Durable Object
  // declaration and the `migrations` array are mutually exclusive, and this
  // deployment keeps RefStore and v1 for single deployments. Append v2 for D34.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RefStore"] },
    { "tag": "v2", "new_sqlite_classes": ["NsCoordinator", "RefShard", "RepoIndexShard", "ContentIndexShard"] }
  ]
}
