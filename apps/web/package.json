{
  "name": "mkit-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "vendor/mkit-wasm",
    "vendor/mkit-repo-client",
    "vendor/mkit-repo-proto"
  ],
  "scripts": {
    "wasm:build": "bun run wasm:build:core && bun run wasm:build:repo-client",
    "wasm:build:core": "rm -rf vendor/mkit-wasm/pkg && cd ../../rust/crates/mkit-wasm && wasm-pack build --target web --out-dir ../../../apps/web/vendor/mkit-wasm/pkg --release",
    "wasm:build:repo-client": "rm -rf vendor/mkit-repo-client/pkg && cd ../../rust/crates/mkit-repo-client && wasm-pack build --target web --out-dir ../../../apps/web/vendor/mkit-repo-client/pkg --release",
    "stage": "node scripts/stage-public.mjs SKILL.md install.sh install.ps1 && node scripts/gen-headers.mjs",
    "dev": "bun run stage && waku dev",
    "build": "bun run stage && bun run wasm:build && CLOUDFLARE=1 waku build && node scripts/assert-prerender.mjs && node scripts/assert-installer.mjs && node scripts/assert-headers.mjs && node scripts/patch-worker-config.mjs && node scripts/fix-preload-as.mjs",
    "start": "waku start",
    "deploy": "bun run build && wrangler deploy -c dist/server/wrangler.json",
    "preview": "bun run build && wrangler dev -c dist/server/wrangler.json",
    "test": "bun run wasm:build && vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src && node scripts/check-no-bracket-vars.mjs",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "typecheck": "bun run wasm:build && tsc --noEmit"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2",
    "@connectrpc/connect": "^2",
    "@connectrpc/connect-web": "^2",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@noble/curves": "^2.2.0",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/query-sync-storage-persister": "^5.101.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-query-persist-client": "^5.101.1",
    "@tanstack/react-virtual": "^3.13.12",
    "hono": "^4.12.25",
    "mkit-repo-client": "workspace:*",
    "mkit-repo-proto": "workspace:*",
    "mkit-wasm": "workspace:*",
    "ox": "^0.14.29",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-server-dom-webpack": "~19.2.7",
    "waku": "1.0.0-beta.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "agentation": "^3.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "wrangler": "^4.99.0"
  }
}
