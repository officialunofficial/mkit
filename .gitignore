.zig-cache/
zig-cache/
zig-out/
.wrangler/
*.log
.DS_Store

# Rust (rewrite/rust branch)
/rust/target/
/rust/**/target/
/rust/Cargo.lock.bak
/rust/fuzz/corpus/
/rust/fuzz/artifacts/
/rust/mutants.out/
/rust/mutants.out.old/

# Test-generated private keys (older path; retained to avoid accidental leaks)
mkit/test-key
.claude/

# Keys, secrets, and local env files — never commit these
*.pem
*.key
*.p12
*.pfx
.env
.env.*
secrets.*
credentials.*

# Build/runtime artifacts
# JS/TS build artifacts
node_modules/
apps/*/node_modules/
apps/*/dist/
apps/*/.vocs/

# Rust dist artifacts (wasm-pack, dist tarballs)
/rust/dist/

# Reference-signers workspace build output (separate workspace, #225)
contrib/signers/target/

# Scratch output of `buf generate` run locally against a proto/buf.gen.yaml
# template (issue #719). Vendored/committed generated code (e.g.
# rust/crates/mkit-rpc/generated/, apps/repo-worker/generated/,
# apps/web/vendor/mkit-repo-proto/generated/, and
# contrib/signers/mkit-sign-se/Sources/mkit-sign-se/Generated/) is refreshed
# by the scripts/regen-*.sh scripts instead, not left here.
**/proto/gen/
